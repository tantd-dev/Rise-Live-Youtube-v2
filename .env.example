# Sao chép thành .env.local rồi sửa. KHÔNG commit .env.local. Tên biến giữ y như bản AB Live cũ.

# ── Bật AB Live + xác thực worker ───────────────────────────────────────
RISE_WORK_LIVE=1
RISE_LIVE_WORKER_TOKEN=doi-thanh-mot-chuoi-ngau-nhien-that-dai   # vé chung; mỗi máy còn có vé riêng = HMAC(vé chung, mã máy)
RISE_LIVE_LEASE=1                 # tự dừng live khi worker mất liên lạc máy chủ (chống phát trùng)
# RISE_LIVE_LEASE_GRACE_SEC=60
# RISE_LIVE_AUTOFAILOVER=1        # tự chuyển live ưu tiên khi máy chết
# RISE_LIVE_FAILOVER_OFFLINE_SEC=90
# RISE_LIVE_FAILOVER_OFF=         # =1 công tắc TẮT KHẨN tự cứu
# RISE_LIVE_THUMB_PUSH_SEC=300
# RISE_LIVE_MIN_FREE_GB=20
# RISE_LIVE_INTERNAL_CRON=1       # =0 khi đã dùng Cloud Scheduler gọi /api/cron/<failover|alerts|youtube>

# ── Firestore (emulator khi chạy thử) ─────────────────────────────────────
GOOGLE_CLOUD_PROJECT=demo-rise-live
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080   # npm run emulator mở đúng cổng này
# RISE_LIVE_EMULATOR_UI_PORT=4000

# ── YouTube (tuỳ chọn) — API key để theo dõi buổi live qua link xem ───────
RISE_YT_API_KEY=
# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET: bản V2 chưa dùng (xem README, mục "Chưa làm")

# ── Đăng nhập thử (chỉ khi có FIRESTORE_EMULATOR_HOST) ────────────────────
ALLOW_DEV_LOGIN=1
DEV_LOGIN_EMAIL=dev@local.test

# ── Địa chỉ app (VPS gọi về đây; dùng trong khối cài worker + email) ──────
APP_BASE_URL=http://localhost:3000

# ── Bí mật cho /api/cron/<việc> (header x-cron-secret) ────────────────────
REPORT_REMINDER_SECRET=doi-thanh-chuoi-ngau-nhien

# ── Tải thẳng video lên VPS + chép VPS→VPS (tuỳ chọn) ────────────────────
# RISE_LIVE_UPLOAD_TOKEN=
# RISE_LIVE_UPLOAD_PORT=8099

# ── Email cảnh báo qua Resend (tuỳ chọn) ─────────────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM=no-reply@ten-mien.vn
# RISE_LIVE_ALERT_EMAILS=a@x.vn,b@x.vn

# ── Worker chạy thử trên máy mình (npm run worker) ────────────────────────
RISE_LIVE_URL=http://localhost:3000
RISE_LIVE_MACHINE=<mã máy lấy từ giao diện>
# RISE_LIVE_TOKEN=<vé riêng của máy; bỏ trống = dùng RISE_LIVE_WORKER_TOKEN>
# RISE_LIVE_WSL_DISTRO=Ubuntu     # chạy worker từ PowerShell: bản WSL dùng để chạy (mặc định Ubuntu)
# RISE_LIVE_AUTO_UPDATE=0        # =0: worker không tự pip cài/cập nhật yt-dlp, gdown
# RISE_LIVE_RTMP_BASE=rtmp://127.0.0.1:1935/live2   # CHỈ chạy thử: đẩy về máy chủ RTMP cục bộ thay vì YouTube
